<core:FragmentDefinition 
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    
    <Dialog
        id="helloDialog"
        title="Hello Dialog {/recipient/name}"
        stretchOnPhone="true">
        <content>
            <core:Icon
                src="sap-icon://hello-world"
                size="8rem"
                class="sapUiMediumMargin"/>
        </content>

    <beginButton>
        <Button
            text="{i18n_test>closeDialogButtonText}"
            press="onCloseDialog" />
    </beginButton>

    </Dialog>
    
</core:FragmentDefinition>